


def is_scalar(mat):
    
    for i in range (len(mat)):

        for j in range (i + 1, len(mat)):
            if mat[i][j] != 0 or mat[j][i] != 0:
                return False
            
          
    for i in range (1, len(mat)):

        if mat[i][i] != mat[0][0]:
            return False
    
    return True
